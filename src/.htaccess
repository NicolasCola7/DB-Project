# Set correct MIME types
AddType text/css .css
AddType text/javascript .js

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Skip rewriting for existing files (like CSS and JS)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Now rewrite everything else to index.php
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
    
    # Prevent direct access to PHP files in src directory
    RewriteRule ^src/.*\.php$ - [R=404,L]
</IfModule>